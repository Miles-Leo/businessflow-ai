APP_NAME="BusinessFlow AI"
# Optional stable secret for local demo sessions; empty means logout on backend restart.
DEMO_SESSION_SECRET=
DEMO_SESSION_HTTPS_ONLY=false
DATABASE_URL=sqlite:///./businessflow.db
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-max
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=businessflow_policy_v1
# Optional small-corpus dense+BM25 retrieval; dense remains the compatible default.
RAG_RETRIEVAL_MODE=dense
# 补齐演示售后政策关联条款；false 可复现原始纯排名检索
RAG_COMPLETE_RELATED_CLAUSES=true

# Feishu local demo; never commit real credentials.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WIKI_NODE_TOKEN=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
